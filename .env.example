APP_NAME="AQUATICA Referidos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Costa_Rica
APP_URL=https://referidos.aquatica.cr

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aquatica_referidos
DB_USERNAME=aquatica_user
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@aquatica.cr"
MAIL_FROM_NAME="${APP_NAME}"

# Configuración Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=aquatica_referidos
EVOLUTION_ADMIN_GROUP_JID=
EVOLUTION_AUTO_NOTIFY_REFEREE=true
EVOLUTION_AUTO_NOTIFY_REFERRER=true
EVOLUTION_NOTIFY_ADMIN_GROUP=true

VITE_APP_NAME="${APP_NAME}"
